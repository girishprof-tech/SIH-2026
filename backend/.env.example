# ─────────────────────────────────────────────────────────────────────────────
# SIH2026 Backend — Environment Variables
# Copy this file to .env and adjust values as needed.
# ─────────────────────────────────────────────────────────────────────────────

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ── Simulation Clock (SCHEMA.md default: 500ms) ───────────────────────────────
# Lower for faster testing: 100ms or 200ms
# Higher for slower demos: 1000ms
SIM_TICK_MS=500

# ── Grid (SCHEMA.md: 30×30) ───────────────────────────────────────────────────
GRID_WIDTH=30
GRID_HEIGHT=30

# ── Fleet (SCHEMA.md: 10 robots) ─────────────────────────────────────────────
FLEET_SIZE=10
ROBOT_PREFIX=AMR

# ── Planner ───────────────────────────────────────────────────────────────────
# Options: "mock" (built-in Space-Time A*) or "external"
PLANNER_BACKEND=mock
# If PLANNER_BACKEND=external, set this to your planner's URL:
PLANNER_URL=

# ── WebSocket ─────────────────────────────────────────────────────────────────
# Max message queue per client before disconnect
WS_MAX_QUEUE=16

# ── Chaos Mode ────────────────────────────────────────────────────────────────
# Default: disabled. Toggle via POST /api/chaos/toggle
CHAOS_ENABLED=false
CHAOS_PACKET_LOSS_PCT=0
